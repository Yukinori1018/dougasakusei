# ===== Required =====
# Anthropic Claude API. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ===== AI voice (choose at least one) =====
# ElevenLabs (recommended default). https://elevenlabs.io/
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_AI=21m00Tcm4TlvDq8ikWAM
# OpenAI TTS fallback. https://platform.openai.com/
OPENAI_API_KEY=
# Google Gemini TTS (alt). https://ai.google.dev/
GEMINI_API_KEY=

# ===== Stock footage / images =====
# Pexels (primary). https://www.pexels.com/api/
PEXELS_API_KEY=
# Pixabay (secondary). https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# ===== AI image gen =====
# fal.ai for Flux. https://fal.ai/
FAL_KEY=

# ===== YouTube =====
# YouTube Data API v3 (for competitor/SEO check, quota-limited).
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_DATA_API_KEY=

# ===== Optional =====
# Suno (BGM gen). Only if subscribed & license verified.
SUNO_API_KEY=

# ===== Behavior =====
# auto | mock — mock runs without external APIs (for testing).
PIPELINE_MODE=auto
# Default LLM tier: haiku | sonnet | opus
DEFAULT_MODEL_TIER=sonnet
# Output directory root
PROJECTS_DIR=projects
